# syntax=docker/dockerfile:1

FROM rust:1.97-alpine AS tools

ARG CARGO_CHEF_VERSION=0.1.77
ARG CARGO_LEPTOS_VERSION=0.3.7

ENV BUILDNAME=hyultisfr
ENV LEPTOS_HASH_FILES=true

RUN apk add --no-cache \
    bash \
    binaryen \
    curl \
    libc-dev \
    make \
    npm \
    perl

RUN npm install --global sass

RUN rustup target add wasm32-unknown-unknown \
    && cargo install \
        --locked \
        --version "${CARGO_CHEF_VERSION}" \
        cargo-chef \
    && cargo install \
        --locked \
        --version "${CARGO_LEPTOS_VERSION}" \
        cargo-leptos

WORKDIR /work


# Analyse uniquement la structure Cargo et les dépendances
FROM tools AS planner

COPY . .

RUN cargo chef prepare --recipe-path recipe.json


# Compile les dépendances, puis l'application
FROM tools AS builder

COPY --from=planner /work/recipe.json ./recipe.json

# Dépendances du serveur SSR
RUN cargo chef cook \
    --release \
    --no-default-features \
    --features ssr \
    --recipe-path recipe.json

# Dépendances du frontend WASM
RUN cargo chef cook \
    --release \
    --target wasm32-unknown-unknown \
    --no-default-features \
    --features hydrate \
    --recipe-path recipe.json

# Cette copie n'invalide désormais que la compilation de l'application
COPY . .

RUN cargo leptos build --release --precompress

RUN mkdir -p /work/build \
    && cp "/work/target/release/${BUILDNAME}" /work/build/leptosapp \
    && cp -R /work/target/site /work/build/site


FROM rustlang/rust:nightly-alpine AS runner

WORKDIR /app

RUN mkdir -p dynamic config

COPY --from=builder /work/build /app
COPY --from=builder /work/Cargo.toml /app/
COPY --from=builder /work/static /app/static

ENV ENV=PROD
ENV LEPTOS_SITE_ADDR=0.0.0.0:3001
ENV LEPTOS_SITE_ROOT=./site
ENV LEPTOS_HASH_FILES=true

EXPOSE 3001

CMD ["/app/leptosapp"]